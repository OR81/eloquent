# Copy this file to .env and fill it in. .env is git-ignored.
# Real environment variables always win over anything set here.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# Retry a statement once on a new connection when the server has gone away.
# On by default; set it to false to be told about every dropped connection.
# DB_RECONNECT=false

# SQLite needs only these two:
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite

# How this connection stores dates, when the whole database uses one convention.
# gregorian (default) | jalali | unix
# DB_DATE_STORAGE=jalali
# DB_DATE_FORMAT=Y/m/d

# A second connection is prefixed with its name.
# REPORTING_DB_CONNECTION=mysql
# REPORTING_DB_DATABASE=analytics
